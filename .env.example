# "mock"  = the whole booking flow runs in the browser with placeholder trips (no backend needed)
# "live"  = calls the New Khan backend API (backend/ folder). Booking requires signing in.
VITE_API_MODE=mock

# Base URL of the backend API (only used when VITE_API_MODE=live)
VITE_API_URL=http://localhost:4000/api/v1

# Optional: Web3Forms access key for the Cargo and Charter enquiry forms (https://web3forms.com, public by design).
# Without it, a submitted enquiry opens WhatsApp with every field already typed in.
VITE_WEB3FORMS_KEY=
